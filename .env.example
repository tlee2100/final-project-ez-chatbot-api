DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

NEXT_PUBLIC_DEMO_SUPER_ADMIN_EMAIL=superadmin@example.com
NEXT_PUBLIC_DEMO_SUPER_ADMIN_PASSWORD=your_super_admin_password

NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=your_admin_password

NEXT_PUBLIC_DEMO_AGENT_EMAIL=agent@example.com
NEXT_PUBLIC_DEMO_AGENT_PASSWORD=your_agent_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

PORT=3000
FRONTEND_URL=http://localhost:3001

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=superAdminPassword123
SUPER_ADMIN_NAME=Super Administrator

CONVERSATION_IDLE_TIMEOUT_MINUTES=5

# ─── LLM & LangGraph Configuration ───
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.ai-box.vn/v1
SYSTEM_PROMPT="You are a helpful customer support chatbot. Please assist the visitor with their inquiries."

# MCP — Internal service-to-service secret (shared with ez-mcp-server API_SECRET_TOKEN)
MCP_INTERNAL_SECRET=your_mcp_internal_secret_here
MCP_SERVER_URL=http://localhost:3002/mcp
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Web crawler (disabled by default in production until explicitly enabled)
CRAWLER_ENABLED=true
BROWSER_WS_ENDPOINT=wss://production-sfo.browserless.io?token=YOUR_TOKEN&timeout=60000
CRAWLER_USER_AGENT=EzChatbotCrawler/1.0

MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_FROMADDRESS=internship@zodinet.com
MAIL_FROMNAME=Internship
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password

